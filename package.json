{
  "name": "web-based-turing-machine-simulator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "chokidar": "^3.5.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.19.0",
    "jest": "^29.0.0",
    "nodemon": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.0.0",
    "@dnd-kit/sortable": "^7.0.0",
    "@dnd-kit/utilities": "^3.2.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@types/dagre": "^0.7.53",
    "@types/js-yaml": "^4.0.9",
    "@types/papaparse": "^5.3.16",
    "@xyflow/react": "^12.8.2",
    "body-parser": "^1.18.3",
    "dagre": "^0.8.5",
    "express": "^4.16.3",
    "file-saver": "^2.0.5",
    "history": "^5.3.0",
    "http-proxy-middleware": "^2.0.6",
    "immer": "^10.0.0",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "mongodb": "^6.0.0",
    "papaparse": "^5.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.15.0",
    "zustand": "^4.4.0"
  },
  "scripts": {
    "clean": "rm -rf public/static/* && mkdir -p public/static",
    "dev": "npm run clean && concurrently \"npm run dev:frontend\" \"npm run dev:server\"",
    "dev:frontend": "node build/build.js --watch",
    "dev:server": "nodemon --watch src/server --exec \"NODE_ENV=development node ./src/server/index.js\"",
    "dev:full": "npm run db:start && npm run dev",
    "serve": "NODE_ENV=development node ./src/server/index.js",
    "start": "NODE_ENV=production node ./src/server/index.js",
    "build": "npm run clean && NODE_ENV=production node build/build.js",
    "build:dev": "node build/build.js",
    "build:watch": "node build/build.js --watch",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest",
    "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch",
    "test:full": "npm run db:start && npm run test && npm run db:stop",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "lint": "npm run type-check",
    "ci": "npm run type-check && npm run build",
    "db:start": "docker-compose -f docker-compose.dev.yml up -d",
    "db:stop": "docker-compose -f docker-compose.dev.yml down",
    "db:reset": "docker-compose -f docker-compose.dev.yml down -v && docker-compose -f docker-compose.dev.yml up -d",
    "db:logs": "docker-compose -f docker-compose.dev.yml logs -f mongodb",
    "db:seed": "echo 'Database seeding is handled by mongo-init.js on first startup'",
    "deploy:prod": "npm run build && mkdir -p logs && pm2 start ecosystem.config.cjs --env production",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop turing-machine",
    "pm2:restart": "pm2 restart turing-machine",
    "pm2:reload": "pm2 reload turing-machine",
    "pm2:delete": "pm2 delete turing-machine",
    "pm2:logs": "pm2 logs turing-machine",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "health": "curl -f http://localhost:3001/api/health || echo 'Health check failed'"
  }
}
